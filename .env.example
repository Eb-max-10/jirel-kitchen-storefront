# ==============================================================================
# JIREL KITCHEN STOREFRONT - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Instructions:
# 1. Copy this file to .env.local for local development:
#    cp .env.example .env.local
# 2. Replace placeholder values with your actual API keys and endpoints.
# 3. NEVER commit .env.local or secret keys into source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Site Metadata & Concierge Contact
# ------------------------------------------------------------------------------
# The canonical domain URL of the deployed storefront
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# WhatsApp business phone number in international format (without + or symbols)
# Example: 2348012345678 (234 = Nigeria country code)
NEXT_PUBLIC_WHATSAPP_PHONE=2349167053972

# Primary customer support and inquiry email address
NEXT_PUBLIC_SUPPORT_EMAIL=support@jirelkitchen.com


# ------------------------------------------------------------------------------
# 2. Paystack Payment Gateway (https://dashboard.paystack.com/#/settings/developer)
# ------------------------------------------------------------------------------
# Public Key (Browser Client): Used by @paystack/inline-js in CartDrawer.tsx
# Format: pk_test_... or pk_live_...
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_placeholder_key_here

# Secret Key (SERVER-ONLY): Used exclusively in /api/checkout/verify/route.ts
# WARNING: NEVER expose this key in client components or prefix with NEXT_PUBLIC_
# Format: sk_test_... or sk_live_...
PAYSTACK_SECRET_KEY=sk_test_placeholder_key_here


# ------------------------------------------------------------------------------
# 3. Supabase Database & Auth (eu-west-1)
# (https://supabase.com/dashboard/project/_/settings/api)
# ------------------------------------------------------------------------------
# Supabase Project URL
# Format: https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Anon Public Key: Safe for browser client reads
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_anon_key_here

# Supabase Service Role Secret Key (SERVER-ONLY):
# Used exclusively in /api/checkout/verify/route.ts to write confirmed orders
# WARNING: Bypasses Row Level Security (RLS). NEVER expose to client!
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_service_role_key_here
